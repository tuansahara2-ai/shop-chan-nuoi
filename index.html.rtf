        \}\
\
        function searchContent() \{\
            const query = document.getElementById('searchInput').value.toLowerCase();\
            if(query.length < 2) return;\
\
            // T\'ecm c\uc0\u7843  b\'e0i vi\u7871 t v\'e0 s\u7843 n ph\u7849 m\
            const foundArts = articles.filter(a => a.title.toLowerCase().includes(query));\
            const foundProds = products.filter(p => p.name.toLowerCase().includes(query));\
\
            let html = `<h3 class="section-header">K\uc0\u7871 t qu\u7843  t\'ecm ki\u7871 m: "$\{query\}"</h3>`;\
            \
            if (foundArts.length > 0) \{\
                html += `<p class="font-bold text-sm mb-2 text-blue-600">B\'e0i vi\uc0\u7871 t ($\{foundArts.length\})</p><div class="grid grid-cols-1 gap-2 mb-4">`;\
                foundArts.forEach(art => \{\
                    html += `<div onclick="viewArticle($\{art.id\})" class="bg-white p-2 rounded border cursor-pointer hover:bg-gray-50">$\{art.title\}</div>`\
                \});\
                html += `</div>`;\
            \}\
\
            if (foundProds.length > 0) \{\
                html += `<p class="font-bold text-sm mb-2 text-red-600">S\uc0\u7843 n ph\u7849 m ($\{foundProds.length\})</p><div class="grid grid-cols-2 md:grid-cols-4 gap-2">`;\
                foundProds.forEach(p => html += createProductCard(p));\
                html += `</div>`;\
            \}\
\
            if(foundArts.length === 0 && foundProds.length === 0) \{\
                html += `<div class="text-center text-gray-500 py-10">Kh\'f4ng t\'ecm th\uc0\u7845 y k\u7871 t qu\u7843  n\'e0o.</div>`;\
            \}\
\
            app.innerHTML = html;\
        \}\
\
        // 5. M\uc0\u7903  Zalo\
        function openZalo() \{\
            // Tr\'ean \uc0\u273 i\u7879 n tho\u7841 i n\'f3 s\u7869  m\u7903  app Zalo\
            window.location.href = `https://zalo.me/$\{MY_ZALO\}`;\
        \}\
        function openZaloProduct(productName) \{\
            // So\uc0\u7841 n s\u7861 n tin nh\u7855 n mua h\'e0ng\
            const msg = `T\'f4i mu\uc0\u7889 n mua: $\{productName\}. T\u432  v\u7845 n gi\'e1 gi\'fap t\'f4i!`;\
            // M\'e3 h\'f3a tin nh\uc0\u7855 n \u273 \u7875  \u273 \u432 a v\'e0o link\
            // Zalo \uc0\u273 \'f4i khi kh\'f4ng h\u7895  tr\u7907  pre-fill text qua link web, nh\u432 ng \u273 \'e2y l\'e0 c\'e1ch chu\u7849 n nh\u7845 t.\
            window.location.href = `https://zalo.me/$\{MY_ZALO\}`; \
            // Ho\uc0\u7863 c copy tin nh\u7855 n v\'e0o clipboard\
            alert(`\uc0\u272 \'e3 copy n\u7897 i dung: "$\{productName\}". H\'e3y d\'e1n v\'e0o chat Zalo nh\'e9!`);\
        \}\
\
        // --- KH\uc0\u7902 I CH\u7840 Y ---\
        renderHome();\
\
    </script>\
</body>\
</html>}
